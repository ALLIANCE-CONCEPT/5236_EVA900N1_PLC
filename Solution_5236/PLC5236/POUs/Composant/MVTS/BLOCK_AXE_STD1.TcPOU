    <LineIds Name="BLOCK_AXE_STD1.ACT_JOG">
      <LineId Id="0" Count="48" />
    </LineIds>
    <LineIds Name="BLOCK_AXE_STD1.ACT_POSITION">
      <LineId Id="0" Count="285" />
    </LineIds>
    <LineIds Name="BLOCK_AXE_STD1.ACT_ROTATION">
      <LineId Id="0" Count="99" />
    </LineIds>
    <LineIds Name="BLOCK_AXE_STD1.ACT_START_SLAVE">
      <LineId Id="0" Count="48" />
    </LineIds>
    <LineIds Name="BLOCK_AXE_STD1.ACT_STOP">
      <LineId Id="0" Count="72" />
    </LineIds>
