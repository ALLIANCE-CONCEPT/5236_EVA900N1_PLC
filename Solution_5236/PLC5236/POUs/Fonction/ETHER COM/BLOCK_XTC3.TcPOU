							VAR_ParameterWriter.fbClientDataExcha.txBuffer[2]:= F_ToASC('U');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[3]:= F_ToASC('F');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[4]:= 16#1E;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[5]:= 16#01;
							TEMP_DWORD := BOOL_TO_DWORD(I_TIME_POWER);
							MEMCPY(ADR(VAR_ParameterWriter.fbClientDataExcha.txBuffer[6]),ADR(TEMP_DWORD),4);
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[10] := VAR_ParameterWriter.fbClientDataExcha.txBuffer[2] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[3] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[4] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[5] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[6] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[7] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[8] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[9];
							VAR_ParameterWriter.fbClientDataExcha.nbTransmittedChar := 11;
							VAR_ParameterWriter.fbClientDataExcha.nbExpectedChar := 6;

						31:	(*Delay Option*)
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[0]:=16#08;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[1]:=16#00;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[2]:= F_ToASC('U');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[3]:= F_ToASC('F');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[4]:= 16#1F;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[5]:= 16#01;
							TEMP_DWORD := BYTE_TO_DWORD(I_Delay_Option);
							MEMCPY(ADR(VAR_ParameterWriter.fbClientDataExcha.txBuffer[6]),ADR(TEMP_DWORD),4);
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[10] := VAR_ParameterWriter.fbClientDataExcha.txBuffer[2] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[3] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[4] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[5] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[6] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[7] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[8] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[9];
							VAR_ParameterWriter.fbClientDataExcha.nbTransmittedChar := 11;
							VAR_ParameterWriter.fbClientDataExcha.nbExpectedChar := 6;

						32:	(*Transfer Sensor*)
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[0]:=16#08;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[1]:=16#00;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[2]:= F_ToASC('U');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[3]:= F_ToASC('F');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[4]:= 16#20;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[5]:= 16#01;
							TEMP_DWORD := INT_TO_DWORD(I_Transfer_sensor);
							MEMCPY(ADR(VAR_ParameterWriter.fbClientDataExcha.txBuffer[6]),ADR(TEMP_DWORD),4);
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[10] := VAR_ParameterWriter.fbClientDataExcha.txBuffer[2] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[3] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[4] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[5] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[6] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[7] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[8] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[9];
							VAR_ParameterWriter.fbClientDataExcha.nbTransmittedChar := 11;
							VAR_ParameterWriter.fbClientDataExcha.nbExpectedChar := 6;

						33:	(*Transfer Tooling*)
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[0]:=16#08;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[1]:=16#00;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[2]:= F_ToASC('U');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[3]:= F_ToASC('F');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[4]:= 16#21;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[5]:= 16#01;
							MEMCPY(ADR(VAR_ParameterWriter.fbClientDataExcha.txBuffer[6]),ADR(I_Transfer_Tool),4);
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[10] := VAR_ParameterWriter.fbClientDataExcha.txBuffer[2] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[3] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[4] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[5] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[6] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[7] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[8] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[9];
							VAR_ParameterWriter.fbClientDataExcha.nbTransmittedChar := 11;
							VAR_ParameterWriter.fbClientDataExcha.nbExpectedChar := 6;

						34:	(*Control Delay Time*)
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[0]:=16#08;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[1]:=16#00;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[2]:= F_ToASC('U');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[3]:= F_ToASC('F');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[4]:= 16#22;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[5]:= 16#01;
							TEMP_DWORD := INT_TO_DWORD(I_Ctrl_Delay_Time);
							MEMCPY(ADR(VAR_ParameterWriter.fbClientDataExcha.txBuffer[6]),ADR(TEMP_DWORD),4);
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[10] := VAR_ParameterWriter.fbClientDataExcha.txBuffer[2] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[3] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[4] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[5] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[6] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[7] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[8] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[9];
							VAR_ParameterWriter.fbClientDataExcha.nbTransmittedChar := 11;
							VAR_ParameterWriter.fbClientDataExcha.nbExpectedChar := 6;

						35:	(*Ion assisted deposition*)
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[0]:=16#08;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[1]:=16#00;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[2]:= F_ToASC('U');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[3]:= F_ToASC('F');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[4]:= 16#23;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[5]:= 16#01;
							TEMP_DWORD := BOOL_TO_DWORD(I_IAD_DEPOSIT);
							MEMCPY(ADR(VAR_ParameterWriter.fbClientDataExcha.txBuffer[6]),ADR(TEMP_DWORD),4);
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[10] := VAR_ParameterWriter.fbClientDataExcha.txBuffer[2] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[3] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[4] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[5] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[6] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[7] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[8] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[9];
							VAR_ParameterWriter.fbClientDataExcha.nbTransmittedChar := 11;
							VAR_ParameterWriter.fbClientDataExcha.nbExpectedChar := 6;
							
						36:	(*Film to run*)
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[0]:=16#07;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[1]:=16#00;
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[2]:= F_ToASC('U');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[3]:= F_ToASC('G');
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[4]:= 16#00; (*n° de paramètre*)
							TEMP_DWORD := 16#01; (*film n°1*)
							MEMCPY(ADR(VAR_ParameterWriter.fbClientDataExcha.txBuffer[5]),ADR(TEMP_DWORD),4);
							VAR_ParameterWriter.fbClientDataExcha.txBuffer[9] := VAR_ParameterWriter.fbClientDataExcha.txBuffer[2] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[3] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[4] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[5] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[6] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[7] +
												VAR_ParameterWriter.fbClientDataExcha.txBuffer[8];
							VAR_ParameterWriter.fbClientDataExcha.nbTransmittedChar := 10;
							VAR_ParameterWriter.fbClientDataExcha.nbExpectedChar := 6;
				END_CASE

			VAR_ParameterWriter.fbClientDataExcha(
								hSocket 		:= VAR_ParameterWriter.hSocket,
								bExecute 	:= TRUE,
								PRM_RECEIVE_POLLING_TIME:= T#1s, (*temporisation de polling de réception*)
								PRM_RECEIVE_TIMEOUT	:= T#10s);	(*temporisation de timeout de communication*)
			VAR_ParameterWriter.eStep := CLIENT_STATE_DATAEXCHA_WAIT;
		END_IF

	CLIENT_STATE_DATAEXCHA_WAIT:	(*Etape 4 - Attente de la fin de l'échange*)
		VAR_ParameterWriter.fbClientDataExcha( bExecute := FALSE );
		IF NOT VAR_ParameterWriter.fbClientDataExcha.bBusy THEN
			IF NOT VAR_ParameterWriter.fbClientDataExcha.bError THEN
				VAR_ParameterWriter.eStep 		:= CLIENT_STATE_DATA_ANALYSE;
			ELSE
				(* possible errors are logged inside of fbClientDataExcha function block *)
				VAR_ParameterWriter.nStepInError := 4;
				VAR_ParameterWriter.nErrId := 	VAR_ParameterWriter.fbClientDataExcha.nErrId;	(*n° d'erreur hérité de la fonction Fb_clientDataExchange*)
				VAR_ParameterWriter.ErrDescription :=	CONCAT(
												CONCAT(VAR_ParameterWriter.fbClientDataExcha.ErrDescription, ' '),
												CONCAT(' -Trame: ',UDINT_TO_STRING(VAR_ParameterWriter.nRequest))
												);
				VAR_ParameterWriter.eStep :=	CLIENT_STATE_ERROR;
			END_IF
		END_IF
	CLIENT_STATE_DATA_ANALYSE:	(*Etape 5 - Analyse des données reçues*)
		(*Contrôle que réponse ne comporte pas une erreur*)
		IF (VAR_ParameterWriter.fbClientDataExcha.rxBuffer[2] = 16#80) THEN
				VAR_ParameterWriter.nStepInError := 5;
				VAR_ParameterWriter.nErrId :=  1;
				VAR_ParameterWriter.ErrDescription := CONCAT(
								CONCAT( 'PACKET ERROR : ',F_ToCHR( VAR_ParameterWriter.fbClientDataExcha.RxBuffer[6])),
								CONCAT(' -Trame: ',UDINT_TO_STRING(VAR_ParameterWriter.nRequest))
								);
				VAR_ParameterWriter.eStep :=	CLIENT_STATE_ERROR;
		ELSE
			VAR_LOAD_PARAM := FALSE;										(*on refait tomber la commande*)
			VAR_ParameterWriter.nRequest := VAR_ParameterWriter.nRequest + 1;	(*incrémentation du n° de trame*)
			IF VAR_ParameterWriter.nRequest = 37 THEN
					VAR_ParameterWriter.nRequest := 0;
					STATE_Prog_Layer_OK := TRUE;
			END_IF
			VAR_ParameterWriter.eStep :=	CLIENT_STATE_IDLE;
		END_IF

	CLIENT_STATE_CLOSE_START:	(*Etape 6 - déclenchement fermeture du port*)
		VAR_ParameterWriter.fbClose( bExecute := FALSE );
		VAR_ParameterWriter.fbClose(
				hSocket:= VAR_ParameterWriter.hSocket,
				bExecute:= TRUE );
		VAR_ParameterWriter.eStep := CLIENT_STATE_CLOSE_WAIT;

	CLIENT_STATE_CLOSE_WAIT: (*Etape 7 - attente de la fermeture du port*)
		VAR_ParameterWriter.fbClose( bExecute := FALSE );
		IF NOT VAR_ParameterWriter.fbClose.bBusy THEN
			VAR_ParameterWriter.bConnected := FALSE;
			MEMSET( ADR(hSocket), 0, SIZEOF(hSocket));
			IF VAR_ParameterWriter.fbClose.bError THEN
				VAR_ParameterWriter.nErrId := VAR_ParameterWriter.fbClose.nErrId;
				VAR_ParameterWriter.nStepInError := 7;
				VAR_ParameterWriter.ErrDescription := CONCAT('FbClose Error : ', UDINT_TO_STRING(VAR_ParameterWriter.fbClose.nErrId));
				VAR_ParameterWriter.eStep := CLIENT_STATE_ERROR;
			ELSE
				VAR_ParameterWriter.bBusy := FALSE;
				VAR_ParameterWriter.bError := FALSE;
				VAR_ParameterWriter.nErrId := 0;
				VAR_ParameterWriter.eStep := CLIENT_STATE_IDLE;
			END_IF
		END_IF

	CLIENT_STATE_ERROR: (* Etape 8 : Error step *)
		VAR_ParameterWriter.bError := TRUE;
		IF VAR_ParameterWriter.bConnected THEN
			VAR_ParameterWriter.eStep := CLIENT_STATE_CLOSE_START;
		ELSE
			VAR_ParameterWriter.bBusy := FALSE;
			//IF DEF_COM_PARAMETER.AR_DEF THEN
				VAR_ParameterWriter.eStep := CLIENT_STATE_IDLE;
			//END_IF
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="COM_STATUS" Id="{9f0affe9-8aa1-44d3-ace7-847326978ddf}">
      <Implementation>
        <ST><![CDATA[CASE VAR_StatusReader.eStep OF
	CLIENT_STATE_IDLE:		(*Etape 0 - sequence d'échange à l'arrêt*)
		(*si autorisé ou exclusif si connecté*)
		IF VAR_StatusReader.bEnable XOR VAR_StatusReader.bConnected THEN
			VAR_StatusReader.bBusy := TRUE;
			VAR_StatusReader.bError := FALSE;
			VAR_StatusReader.nErrid := 0;
			IF VAR_StatusReader.bEnable THEN
				VAR_StatusReader.fbConnectTON( IN := FALSE );
				VAR_StatusReader.eStep := CLIENT_STATE_CONNECT_START;
			ELSE
				VAR_StatusReader.eStep := CLIENT_STATE_CLOSE_START;
			END_IF
		ELSIF VAR_StatusReader.bConnected THEN
			VAR_StatusReader.fbDataExchaTON( IN := FALSE );
			VAR_StatusReader.eStep := CLIENT_STATE_DATAEXCHA_START;
		ELSE
			VAR_StatusReader.bBusy := FALSE;
		END_IF

	CLIENT_STATE_CONNECT_START: (*Etape 1 - connexion au port*)
		(*temporisation de reconnexion*)
		VAR_StatusReader.fbConnectTON( IN := TRUE, PT := VAR_StatusReader.connectTime);
		(*si tempo de reconnexion ok*)
		IF VAR_StatusReader.fbConnectTON.Q THEN
			VAR_StatusReader.fbConnectTON( IN := FALSE );
			VAR_StatusReader.fbConnect(  bExecute := FALSE  );
			VAR_StatusReader.fbConnect(
						sRemoteHost		:= CONF_sRemoteHost,
						nRemotePort		:= CONF_nRemotePort,
						 sSrvNetId		:= '',
						bExecute		:= TRUE );
			VAR_StatusReader.eStep := CLIENT_STATE_CONNECT_WAIT;
			VAR_StatusReader.nRequest := 0; (*reinitalisation du n° de requete à 0*)
			VAR_StatusReader.Compteur_connection := VAR_StatusReader.Compteur_connection + 1;
		END_IF

	CLIENT_STATE_CONNECT_WAIT:	(*Etape 2 - attente connexion ok*)
		VAR_StatusReader.fbConnect( bExecute := FALSE );
		IF NOT VAR_StatusReader.fbConnect.bBusy THEN
			IF NOT VAR_StatusReader.fbConnect.bError THEN
				VAR_StatusReader.bConnected 	:= TRUE;
				VAR_StatusReader.hSocket 	:= VAR_StatusReader.fbConnect.hSocket;
				VAR_StatusReader.eStep 		:= CLIENT_STATE_IDLE;
				Def_connect_com_status := FALSE;
			ELSE
				(*LogError( 'FB_SocketConnect', fbConnect.nErrId );*)
				VAR_StatusReader.nErrId := VAR_StatusReader.fbConnect.nErrId;
				VAR_StatusReader.nStepInError  := 2;
				VAR_StatusReader.ErrDescription := CONCAT('FbConnect Error : ', UDINT_TO_STRING(VAR_StatusReader.fbConnect.nErrId));
				VAR_StatusReader.eStep := CLIENT_STATE_ERROR;
				Def_connect_com_status := TRUE;
			END_IF
		END_IF

	CLIENT_STATE_DATAEXCHA_START:	(*Etape 3 - lancement des échanges*)
		VAR_StatusReader.fbDataExchaTON( IN := TRUE, PT := VAR_StatusReader.ExchangeCycleTime );
		IF VAR_StatusReader.fbDataExchaTON.Q THEN
			VAR_StatusReader.fbDataExchaTON( IN := FALSE );
			VAR_StatusReader.fbClientDataExcha( bExecute := FALSE );

			CASE VAR_StatusReader.nRequest  OF
			0:
				(*Current Rate - S1*)
				VAR_StatusReader.fbClientDataExcha.txBuffer[0]:=16#02;
				VAR_StatusReader.fbClientDataExcha.txBuffer[1]:=16#00;
				VAR_StatusReader.fbClientDataExcha.txBuffer[2]:= F_ToASC('S');
				VAR_StatusReader.fbClientDataExcha.txBuffer[3]:= 16#01;
				VAR_StatusReader.fbClientDataExcha.txBuffer[4]:= VAR_StatusReader.fbClientDataExcha.txBuffer[2] +
															VAR_StatusReader.fbClientDataExcha.txBuffer[3];
				VAR_StatusReader.fbClientDataExcha.nbTransmittedChar := 5;
				VAR_StatusReader.fbClientDataExcha.nbExpectedChar := 10;
			1:
				(*Process Information - S0*)
				VAR_StatusReader.fbClientDataExcha.txBuffer[0]:=16#03;
				VAR_StatusReader.fbClientDataExcha.txBuffer[1]:=16#00;
				VAR_StatusReader.fbClientDataExcha.txBuffer[2]:= F_ToASC('S');
				VAR_StatusReader.fbClientDataExcha.txBuffer[3]:= 16#00;
				VAR_StatusReader.fbClientDataExcha.txBuffer[4]:= STATE_Timer_Tick;
				VAR_StatusReader.fbClientDataExcha.txBuffer[5]:= VAR_StatusReader.fbClientDataExcha.txBuffer[2] +
															VAR_StatusReader.fbClientDataExcha.txBuffer[3] +
															VAR_StatusReader.fbClientDataExcha.txBuffer[4];
				VAR_StatusReader.fbClientDataExcha.nbTransmittedChar := 6;
				VAR_StatusReader.fbClientDataExcha.nbExpectedChar := 30;

			2:	(*Crystal Life - S9*)
				VAR_StatusReader.fbClientDataExcha.txBuffer[0]:= 16#02;
				VAR_StatusReader.fbClientDataExcha.txBuffer[1]:=16#00;
				VAR_StatusReader.fbClientDataExcha.txBuffer[2]:= F_ToASC('S');
				VAR_StatusReader.fbClientDataExcha.txBuffer[3]:= 16#09;  (*09*)
				VAR_StatusReader.fbClientDataExcha.txBuffer[4]:= VAR_StatusReader.fbClientDataExcha.txBuffer[2] +
															VAR_StatusReader.fbClientDataExcha.txBuffer[3];
				VAR_StatusReader.fbClientDataExcha.nbTransmittedChar := 5;
				VAR_StatusReader.fbClientDataExcha.nbExpectedChar := 7;

			3:	(*Etat STOP*)
				VAR_StatusReader.fbClientDataExcha.txBuffer[0]:=16#02;
				VAR_StatusReader.fbClientDataExcha.txBuffer[1]:=16#00;
				VAR_StatusReader.fbClientDataExcha.txBuffer[2]:= F_ToASC('S');
				VAR_StatusReader.fbClientDataExcha.txBuffer[3]:=16#12;
				VAR_StatusReader.fbClientDataExcha.txBuffer[4]:= VAR_StatusReader.fbClientDataExcha.txBuffer[2] +
															VAR_StatusReader.fbClientDataExcha.txBuffer[3];
				VAR_StatusReader.fbClientDataExcha.nbTransmittedChar := 5;
				VAR_StatusReader.fbClientDataExcha.nbExpectedChar := 7;

			4: 	(*etat des entrées de l'XTC*)
				VAR_StatusReader.fbClientDataExcha.txBuffer[0]:=16#02;
				VAR_StatusReader.fbClientDataExcha.txBuffer[1]:=16#00;
				VAR_StatusReader.fbClientDataExcha.txBuffer[2]:= F_ToASC('S');
				VAR_StatusReader.fbClientDataExcha.txBuffer[3]:=16#0C;
				VAR_StatusReader.fbClientDataExcha.txBuffer[4]:= VAR_StatusReader.fbClientDataExcha.txBuffer[2] +
															VAR_StatusReader.fbClientDataExcha.txBuffer[3];
				VAR_StatusReader.fbClientDataExcha.nbTransmittedChar := 5;

			END_CASE

			VAR_StatusReader.fbClientDataExcha(
								hSocket 		:= VAR_StatusReader.hSocket,
								bExecute 	:= TRUE,
								PRM_RECEIVE_POLLING_TIME:= T#1s, (*temporisation de polling de réception*)
								PRM_RECEIVE_TIMEOUT	:= T#10s);	(*temporisation de timeout de communication*)
			VAR_StatusReader.eStep := CLIENT_STATE_DATAEXCHA_WAIT;
		END_IF

	CLIENT_STATE_DATAEXCHA_WAIT:	(*Etape 4 - Attente de la fin de l'échange*)
		VAR_StatusReader.fbClientDataExcha( bExecute := FALSE );
		IF NOT VAR_StatusReader.fbClientDataExcha.bBusy THEN
			IF NOT VAR_StatusReader.fbClientDataExcha.bError THEN
				VAR_StatusReader.eStep 		:= CLIENT_STATE_DATA_ANALYSE;
			ELSE
				(* possible errors are logged inside of fbClientDataExcha function block *)
				VAR_StatusReader.nStepInError := 4;
				VAR_StatusReader.nErrId := 	VAR_StatusReader.fbClientDataExcha.nErrId;	(*n° d'erreur hérité de la fonction Fb_clientDataExchange*)
				VAR_StatusReader.ErrDescription :=	CONCAT(
												CONCAT(VAR_StatusReader.fbClientDataExcha.ErrDescription, ' '),
												CONCAT(' -Trame: ',UDINT_TO_STRING(VAR_StatusReader.nRequest))
												);
				VAR_StatusReader.eStep :=	CLIENT_STATE_ERROR;
			END_IF
		END_IF
	CLIENT_STATE_DATA_ANALYSE:	(*Etape 5 - Analyse des données reçues*)
		(*si retour d'une trame signalant une erreur*)
		IF (VAR_StatusReader.fbClientDataExcha.rxBuffer[2] = 16#80) THEN
				VAR_StatusReader.nStepInError := 5;
				VAR_StatusReader.nErrId :=  1;
				VAR_StatusReader.ErrDescription := CONCAT(
								CONCAT( 'PACKET ERROR : ',F_ToCHR( VAR_StatusReader.fbClientDataExcha.RxBuffer[6])),
								CONCAT(' -Trame: ',UDINT_TO_STRING(VAR_StatusReader.nRequest))
								);
				VAR_StatusReader.eStep :=	CLIENT_STATE_ERROR;
		ELSE
			CASE VAR_StatusReader.nRequest  OF
				0:
					STATE_Timer_Tick:= VAR_StatusReader.fbClientDataExcha.RxBuffer[3];
					(*Récuperation de la vitesse d'évaporation*)
					MEMCPY(ADR(STATE_Rate),ADR(VAR_StatusReader.fbClientDataExcha.rxBuffer[5]),4);
				1:
					STATE_Timer_Tick:= VAR_StatusReader.fbClientDataExcha.rxBuffer[3];		(*Récuperation de la valeur du timer tick*)
					STATE_Sensor_Fail:= VAR_StatusReader.fbClientDataExcha.rxBuffer[5].0;		(*Etat du Quartz*)
					STATE_NPHASE := VAR_StatusReader.fbClientDataExcha.rxBuffer[6];		(*Phase en cours*)
					CASE	STATE_NPHASE OF
							0:
								STATE_Phase:= 'Ready';
							1:
								STATE_Phase:= 'Crucible Switch';
							2:
								STATE_Phase:= 'Rise 1';
							3:
								STATE_Phase:= 'Soak 1';
							4:
								STATE_Phase:= 'Rise 2';
							5:
								STATE_Phase:= 'Soak 2';
							6:
								STATE_Phase:= 'Shutter Delay';
							7:
								STATE_Phase:= 'Deposit';
							8:
								STATE_Phase:= 'Rate Ramp';
							9:
								STATE_Phase:= 'Manual';
							10:
								STATE_Phase:= 'Time Power';
							11:
								STATE_Phase:= 'Idle Ramp';
							12:
								STATE_Phase:= 'Idle';
				END_CASE
				STATE_Active_Sensor:= VAR_StatusReader.fbClientDataExcha.rxBuffer[7];
				STATE_Active_Crystal:= VAR_StatusReader.fbClientDataExcha.rxBuffer[8];
				(*Récuperation de la vitesse d'évaporation*)
				MEMCPY(ADR(STATE_Rate),ADR(VAR_StatusReader.fbClientDataExcha.rxBuffer[9]),4);
				(*Récuperation de l'épaisseur*)
				MEMCPY(ADR(STATE_Thickness),ADR(VAR_StatusReader.fbClientDataExcha.rxBuffer[13]),4);
				(*Récupération de la puissance*)
				MEMCPY(ADR(STATE_Power),ADR(VAR_StatusReader.fbClientDataExcha.rxBuffer[17]),4);
				(*Récuperation de la déviation de vitesse*)
				MEMCPY(ADR(STATE_Rate_Deviation),ADR(VAR_StatusReader.fbClientDataExcha.rxBuffer[21]),4);
				(*Récuperation de la fréquence*)
				MEMCPY(ADR(temp_dword),ADR(VAR_StatusReader.fbClientDataExcha.rxBuffer[25]),4);
				STATE_Frequency := temp_dword * VAR_Freq_Multiplieur;
			2:
				(*Récuperation de la durée de vie du Quartz*)
				STATE_Crystal_Life:= VAR_StatusReader.fbClientDataExcha.rxBuffer[5];
			3:
				STATE_STOP	:=	BYTE_TO_BOOL(VAR_StatusReader.fbClientDataExcha.rxBuffer[5]);

		END_CASE
		VAR_StatusReader.nRequest := VAR_StatusReader.nRequest + 1;	(*incrémentation du n° de trame*)
		IF VAR_StatusReader.nRequest = 4 THEN
			VAR_StatusReader.nRequest := 0;
		END_IF
		VAR_StatusReader.eStep :=	CLIENT_STATE_IDLE;
	END_IF

	CLIENT_STATE_CLOSE_START:	(*Etape 6 - déclenchement fermeture du port*)
		VAR_StatusReader.fbClose( bExecute := FALSE );
		VAR_StatusReader.fbClose(
				hSocket:= VAR_StatusReader.hSocket,
				bExecute:= TRUE );
		VAR_StatusReader.eStep := CLIENT_STATE_CLOSE_WAIT;

	CLIENT_STATE_CLOSE_WAIT: (*Etape 7 - attente de la fermeture du port*)
		VAR_StatusReader.fbClose( bExecute := FALSE );
		IF NOT VAR_StatusReader.fbClose.bBusy THEN
			VAR_StatusReader.bConnected := FALSE;
			MEMSET( ADR(hSocket), 0, SIZEOF(hSocket));
			IF VAR_StatusReader.fbClose.bError THEN
				VAR_StatusReader.nErrId := VAR_StatusReader.fbClose.nErrId;
				VAR_StatusReader.nStepInError := 7;
				VAR_StatusReader.ErrDescription := CONCAT('FbClose Error : ', UDINT_TO_STRING(VAR_StatusReader.fbClose.nErrId));
				VAR_StatusReader.eStep := CLIENT_STATE_ERROR;
			ELSE
				VAR_StatusReader.bBusy := FALSE;
				VAR_StatusReader.bError := FALSE;
				VAR_StatusReader.nErrId := 0;
				VAR_StatusReader.eStep := CLIENT_STATE_IDLE;
			END_IF
		END_IF

	CLIENT_STATE_ERROR: (* Etape 8 : Error step *)
		VAR_StatusReader.bError := TRUE;
		IF VAR_StatusReader.bConnected THEN
			VAR_StatusReader.eStep := CLIENT_STATE_CLOSE_START;
		ELSE
			VAR_StatusReader.bBusy := FALSE;
			//IF DEF_COM_STATUS.AR_DEF THEN
				VAR_StatusReader.eStep := CLIENT_STATE_IDLE;
			//END_IF
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="POST" Id="{deaaa977-4f70-4989-af18-2d5a64511487}">
      <Implementation>
        <ST><![CDATA[(*Action G7 de gestion*)
(*étape 1 - Récupération des informations XTC*)
VAR_StatusReader.bEnable := OP_Gest.Etape.1;

(*étape 3 - Chargement des paramètres XTC*)
VAR_ParameterWriter.bEnable :=  OP_Gest.Etape.3;

(*étape 6 - Envoie d'une commande XTC*)
VAR_CommandWriter.bEnable := OP_Gest.Etape.6;


(*Défaut de Communication*)
IF (VAR_StatusReader.eStep = CLIENT_STATE_ERROR) AND NOT (VAR_StatusReader.nStepInError  = 2) THEN
	Condition_def_com_status := TRUE;
ELSIF Def_connect_com_status AND (VAR_StatusReader.nStepInError  = 2) THEN
	Condition_def_com_status := TRUE;
ELSE
	Condition_def_com_status := FALSE;
END_IF

DEF_COM_STATUS.CONDITION:= Condition_def_com_status AND NOT I_Inhibe_Def;
DEF_COM_STATUS.DELAY:= T#0s;
DEF_COM_STATUS.VAL1 := VAR_StatusReader.ErrDescription;
DEF_COM_STATUS();

(*Défaut de Communication*)
IF (VAR_ParameterWriter.eStep = CLIENT_STATE_ERROR) AND NOT (VAR_ParameterWriter.nStepInError  = 2) THEN
	Condition_def_com_parameters := TRUE;
ELSIF Def_connect_com_parameters AND (VAR_ParameterWriter.nStepInError  = 2) THEN
	Condition_def_com_parameters := TRUE;
ELSE
	Condition_def_com_parameters := FALSE;
END_IF

DEF_COM_PARAMETER.CONDITION:= Condition_def_com_parameters AND NOT I_Inhibe_Def;
DEF_COM_PARAMETER.DELAY:= T#0s;
DEF_COM_PARAMETER.VAL1 := VAR_ParameterWriter.ErrDescription;
DEF_COM_PARAMETER();

(*Défaut de Communication*)
IF (VAR_CommandWriter.eStep = CLIENT_STATE_ERROR) AND NOT (VAR_CommandWriter.nStepInError  = 2) THEN
	Condition_def_com_command := TRUE;
ELSIF Def_connect_com_command AND (VAR_CommandWriter.nStepInError  = 2) THEN
	Condition_def_com_command := TRUE;
ELSE
	Condition_def_com_command := FALSE;
END_IF

DEF_COM_COMMAND.CONDITION:= Condition_def_com_command AND NOT I_Inhibe_Def;
DEF_COM_COMMAND.DELAY:= T#0s;
DEF_COM_COMMAND.VAL1 := VAR_CommandWriter.ErrDescription;
DEF_COM_COMMAND();


(*Indicateur driver en fonctionnement*)
TIMER_STATE_READY.IN := (VAR_StatusReader.bConnected OR VAR_CommandWriter.bConnected OR VAR_ParameterWriter.bConnected) AND NOT STATE_NOK;
TIMER_STATE_READY.PT := T#10S;
TIMER_STATE_READY();

STATE_READY:= TIMER_STATE_READY.Q;

(*Indicateur contrôleur NON OK*)
STATE_NOK:= DEF_COM_PARAMETER.DEF OR DEF_COM_COMMAND.DEF OR DEF_COM_STATUS.DEF;

(*RAZ Indicateur de programmation couche ok*)
IF OP_Gest.Etape.1 THEN
	STATE_Prog_Layer_OK := FALSE;
END_IF

(*RAZ Indicateur d'action ok*)
IF OP_Gest.Etape.1 THEN
	STATE_ACTION_OK := FALSE;
	STATE_RAZ_THICK_OK := FALSE;
	STATE_START_OK:=FALSE;
	STATE_STOP_OK:=FALSE;
	STATE_RESET_OK:=FALSE;
	STATE_SWITCH_XTAL_OK:=FALSE;
END_IF

(*Affectation sorties*)
OUT_STOP_STATE		:=	IN_CD31T;
OUT_END_OF_PROCESS	:=	IN_CD32T;
OUT_CRYSTAL_FAIL		:=	IN_CD33T;
OUT_ALARMS			:=	IN_CD34T;
OUT_CACHE_SRCE		:=	IN_CD35T;
OUT_CACHE_QUARTZ	:=	IN_CD36T;
OUT_POWER_SP		:=	IN_CD31Q;]]></ST>
      </Implementation>
    </Action>
    <Action Name="PRL" Id="{a46881c8-1c00-4d25-9173-41e7b907ba7d}">
      <Implementation>
        <ST><![CDATA[(*Défaut*)
DEF_COM_STATUS.IdXML := '16';
DEF_COM_STATUS.TagXML := 1;

DEF_COM_PARAMETER.IdXML := '16';
DEF_COM_PARAMETER.TagXML := 2;

DEF_COM_COMMAND.IdXML := '16';
DEF_COM_COMMAND.TagXML := 3;

VAR_Freq_Multiplieur	:= 0.0034924596;

(*Reception des bit d'ordre de maintenance*)
RCP_M_Start := M_Start;
RCP_M_Stop := M_Stop;
RCP_M_Reset := M_reset;
RCP_M_RAZ_Thick := M_RAZ_Thick;
RCP_M_Load_param := M_Load_param;
RCP_M_Switch_Crystal := M_Switch_Crystal;

(*Gestion de la sortie de mode manuel*)
(*les demandes d'action en mode manuel en attente sont resetées*)
FD_Manual(CLK:= Manual);

(*********Réception des ordres externes**********)
(*********demande de start ********)
FM_CO_Start(CLK:= CO_START);
IF	(*(NOT CO_START AND NOT MANUAL)
	OR *)FD_Manual.Q
	OR RESET THEN
	VAR_Start:= FALSE;
END_IF
IF 	((FM_CO_Start.Q AND NOT MANUAL)
	OR (RCP_M_Start AND MANUAL))
	AND NOT RESET  THEN
	VAR_Start:= TRUE;
END_IF


(**********demande de stop*********)
FM_CO_Stop(CLK:= CO_STOP);
IF	(NOT CO_STOP AND NOT MANUAL)
	OR FD_Manual.Q OR RESET THEN
	VAR_Stop:= FALSE;
END_IF
IF 	((FM_CO_Stop.Q AND NOT MANUAL)
	OR (RCP_M_Stop AND MANUAL))
	AND NOT RESET  THEN
	VAR_Stop:= TRUE;
END_IF

(*demande de RAZ épaisseur*)
FM_CO_Raz_Thick(CLK:= CO_RAZ_THICK);
IF	(NOT CO_RAZ_THICK AND NOT MANUAL)
	OR FD_Manual.Q OR RESET THEN
	VAR_Raz_Thick:= FALSE;
END_IF
IF 	((FM_CO_Raz_Thick.Q AND NOT MANUAL)
	OR (RCP_M_Raz_Thick AND MANUAL))
	AND NOT RESET  THEN
	VAR_Raz_Thick:= TRUE;
END_IF

(*demande de reset du contrôleur*)
FM_CO_RESET_Ctrl(CLK:= CO_RESET_Ctrl);
IF	(NOT CO_RESET_Ctrl AND NOT MANUAL)
	OR FD_Manual.Q OR RESET THEN
	VAR_Reset:= FALSE;
END_IF
IF 	((FM_CO_RESET_Ctrl.Q AND NOT MANUAL)
	OR (RCP_M_Reset  AND MANUAL))
	AND NOT RESET  THEN
	VAR_Reset:= TRUE;
END_IF

(*demande de programmation de la couche*)
FM_CO_Load_Param(CLK:= CO_Load_Param);
IF	(NOT CO_LOAD_PARAM AND NOT MANUAL)
	OR FD_Manual.Q OR RESET THEN
	VAR_LOAD_PARAM:= FALSE;
END_IF
IF 	((FM_CO_Load_Param.Q AND NOT MANUAL)
	OR (RCP_M_Load_Param  AND MANUAL))
	AND NOT RESET  THEN
	VAR_LOAD_PARAM:= TRUE;
END_IF

(*demande de switch du crystal*)
FM_CO_Switch_Crystal(CLK:= CO_Switch_Crystal);
IF	(NOT CO_Switch_Crystal AND NOT MANUAL)
	OR FD_Manual.Q
	OR RESET THEN
	VAR_SWITCH_CRYSTAL:= FALSE;
END_IF
IF 	((FM_CO_Switch_Crystal.Q AND NOT MANUAL)
	OR (RCP_M_Switch_Crystal AND MANUAL))
	AND NOT RESET  THEN
	VAR_SWITCH_CRYSTAL:= TRUE;
END_IF

(*RAZ des bit de d'ordre en mode manuel*)
IF RCP_M_Start AND M_Start THEN
	M_START:=FALSE;
END_IF
IF RCP_M_Stop AND M_Stop THEN
	M_STOP:=FALSE;
END_IF
IF RCP_M_Reset AND M_reset THEN
	M_RESET:=FALSE;
END_IF
IF RCP_M_RAZ_Thick AND M_RAZ_Thick THEN
	M_RAZ_Thick:=FALSE;
END_IF
IF RCP_M_Load_param AND M_Load_param THEN
	M_Load_param := FALSE;
END_IF
IF RCP_M_Switch_Crystal AND M_Switch_Crystal THEN
	M_Switch_Crystal:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
