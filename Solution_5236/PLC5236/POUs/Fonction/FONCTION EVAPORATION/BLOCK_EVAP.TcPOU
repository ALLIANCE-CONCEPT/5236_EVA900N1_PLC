DEF_PMIN.IdXML := '14';
DEF_Pmin.TagXML := 12;

DEF_TEMPS_MAX.IdXML := '14';
DEF_TEMPS_MAX.TagXML  := 11;

DEF_REF.IdXML := '14';
DEF_REF.TagXML:= 28;]]></ST>
      </Implementation>
