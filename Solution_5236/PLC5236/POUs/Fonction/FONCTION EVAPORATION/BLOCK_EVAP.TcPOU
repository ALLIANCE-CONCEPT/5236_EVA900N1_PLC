      <Implementation>
        <ST><![CDATA[OP_MARCHE.IdXML		:=	'0';
OP_MARCHE.TagXML	:=	1;

OP_STOP.IdXML		:=	'0';
OP_STOP.TagXML		:=	2;

DEF_QZ_CTRL_RATE.IDXML := '14';
DEF_QZ_CTRL_RATE.TagXML := 8;

DEF_PMAX.IdXML	:=	'14';
