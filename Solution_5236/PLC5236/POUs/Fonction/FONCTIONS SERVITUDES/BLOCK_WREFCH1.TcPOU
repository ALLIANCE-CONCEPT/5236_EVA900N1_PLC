      <LineId Id="0" Count="60" />
    </LineIds>
    <LineIds Name="BLOCK_WREFCH1.POST">
      <LineId Id="0" Count="90" />
    </LineIds>
    <LineIds Name="BLOCK_WREFCH1.PRL">
      <LineId Id="0" Count="54" />
    </LineIds>
  </POU>
</TcPlcObject>