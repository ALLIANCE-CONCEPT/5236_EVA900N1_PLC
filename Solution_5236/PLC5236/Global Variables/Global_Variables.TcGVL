  <GVL Name="Global_Variables" Id="{2f84d764-16b2-416e-86a1-1cf3a71ad672}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL

	(*Variable de vérification de chargement des variables persistentes ok*)
	{attribute 'OPC.UA.DA'  := '1'}
	STATE_Charg_Persistentes_Ok:	BOOL;

	(*Général*)
	{attribute 'OPC.UA.DA'  := '1'}
	MACHINE:						BLOCK_MODE_MARCHE_V2_0;
	{attribute 'OPC.UA.DA'  := '1'}
	INIT_MACHINE:					BLOCK_INIT_MACHINE;
	{attribute 'OPC.UA.DA'  := '1'}
	EXECPROC:						BLOCK_EXEC_PROC;
	{attribute 'OPC.UA.DA'  := '1'}
	MODE_QUARTZ_PROD:				BLOCK_1RUN_1QUARTZ;

	(*Instances des PRG*)
	{attribute 'OPC.UA.DA'  := '1'}
