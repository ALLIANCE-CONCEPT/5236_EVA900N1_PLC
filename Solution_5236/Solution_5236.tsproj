											<Value>0xa</Value>
											<Text>r-cF / Process value red when the measured value is between the freely definable limit values [cFL.T] and [cFH.T]</Text>
										</Enums>
										<Enums>
											<Value>0xb</Value>
											<Text>G-cF / Process value green when the measured value is between the freely definable limit values [cFL.T] and [cFH.T]</Text>
										</Enums>
									</Items>
